# ── Jarvis AI Environment Configuration ──────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── AI Brain (Required) ──────────────────────────────────────
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_FALLBACK=your-secondary-gemini-api-key-here-optional
GEMINI_MODEL=gemini-2.0-flash-lite

# ── Voice Settings ───────────────────────────────────────────
JARVIS_VOICE=Daniel
JARVIS_SPEECH_RATE=180
STT_LANGUAGE=en-US

# ── Identity ─────────────────────────────────────────────────
JARVIS_NAME=Jarvis
USER_NAME=Sir

# ── Browser ──────────────────────────────────────────────────
# Options: chrome, brave, safari, firefox, arc
DEFAULT_BROWSER=chrome

# ── LinkedIn Job Search Defaults ─────────────────────────────
LINKEDIN_JOB_TITLE=Software Developer
LINKEDIN_JOB_LOCATION=India

# ── Gmail ────────────────────────────────────────────────────
# Place your credentials.json in the project root
# Token will be auto-generated on first email read
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_MAX_EMAILS=10

LEETCODE_USERNAME=""
