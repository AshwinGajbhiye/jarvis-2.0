# ── Jarvis AI Environment Configuration ──────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── AI Brain (Required) ──────────────────────────────────────
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_FALLBACK=your-secondary-gemini-api-key-here-optional
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Antigravity Autonomous Brain (Optional) ───────────────────
# Set USE_ANTIGRAVITY=true to use Google Antigravity SDK Agent as the intelligence layer
USE_ANTIGRAVITY=false
ANTIGRAVITY_MODEL=gemini-2.5-flash

# ── Browser & Automation ──────────────────────────────────────
# Options: chrome, brave, safari, firefox, arc
DEFAULT_BROWSER=chrome
BROWSER_CDP_PORT=9222
AUTO_SKIP_YOUTUBE_ADS=true

# ── Voice Settings ───────────────────────────────────────────
JARVIS_VOICE=Daniel
JARVIS_SPEECH_RATE=180
STT_LANGUAGE=en-US

# ── Identity ─────────────────────────────────────────────────
JARVIS_NAME=Jarvis
USER_NAME=Sir

# ── Browser ──────────────────────────────────────────────────
# Options: chrome, brave, safari, firefox, arc
DEFAULT_BROWSER=chrome

# ── LinkedIn Job Search Defaults ─────────────────────────────
LINKEDIN_JOB_TITLE=Software Developer
LINKEDIN_JOB_LOCATION=India

# ── Gmail & Email Sending ────────────────────────────────────
# Option 1: Gmail API (OAuth2)
# Place your credentials.json in the project root
# Token will be auto-generated on first email operation
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_MAX_EMAILS=10

# Option 2: SMTP (Zero-OAuth setup for cold mailing)
# For Gmail: Use an App Password (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM_NAME="Ashwin Gajbhiye"
EMAIL_DISPATCH_METHOD=smtp

# ── Job Search & Cold Outreach Profiles ──────────────────────
RESUME_PATH=~/.jarvis/resume.pdf
USER_PROFILE_PATH=~/.jarvis/user_profile.json
COLD_APPLICATIONS_PATH=~/.jarvis/cold_applications.json

LEETCODE_USERNAME=""
MOBILE_API_KEY=jarvis-mobile-secret-key-2026

